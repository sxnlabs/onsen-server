# Onsen container config — copy to `.env` (kept out of git) and fill in.

# Spa wifi module IP on the home LAN, reachable through the WireGuard tunnel.
INTEX_SPA_HOST=192.168.1.50

# Protect the web UI — strongly recommended now that it runs off your Mac.
HERMES_PASSWORD=change-me

# Weather (Open-Meteo). Defaults are Brest; set to your spa's location.
WEATHER_LAT=48.45
WEATHER_LON=-4.42

# Optional tuning (defaults shown — uncomment to change).
# INTEX_SPA_PORT=8990
# INTEX_SPA_POLL=10
# HERMES_IO_THREADS=8
# WEATHER_ENABLED=1

# --- SMS alerting (opt-in) --------------------------------------------------
# Onsen texts you itself rather than going through Argos: Argos runs on the same
# host, so it can't be what notices that host disappear. Leave ONSEN_SMS_TO empty
# to disable alerting entirely; setting it without the OVH keys (or the reverse)
# logs an error at startup rather than pretending to be armed.
# ONSEN_SMS_TO=+336xxxxxxxx
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=
# OVH_SMS_SERVICE=sms-xxxxxxx-1
# OVH_SMS_SENDER=SXNLABS

# What earns a text, and after how long (defaults shown).
# ONSEN_ALERT_UNREACHABLE_AFTER=3600     # spa silent for this long → SMS
# ONSEN_ALERT_WATER_LOW_C=30             # water at/below this with a higher setpoint; "off" disables
# ONSEN_ALERT_HEATING_STALL_HOURS=2      # heat running this long without +1C
